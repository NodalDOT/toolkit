{
  "name": "toolkit",
  "version": "1.0.0",
  "description": "Simple web toolkit",
  "license": "ISC",
  "author": "Nodal-dot",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p tsconfig.node.json && pnpm -r typecheck",
    "format": "prettier . --write",
    "lint": "eslint . --fix && stylelint \"**/*.css\" --fix",
    "test": "pnpm -r test",
    "start": "node server/index.ts"
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "fastify": "^5.8.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@toolkit/directive-dispatcher": "workspace:*",
    "@toolkit/route-indexer": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "htmlnano": "^3.3.2",
    "prettier": "3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-pepelsbey": "^1.3.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
