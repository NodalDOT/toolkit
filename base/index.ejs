<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./style.css">
    
    <title>Document</title>
</head>
<body>
    <header></header>
    <main>
        <aside>
            <% for (const [blockKey, block] of Object.entries(structure)) { %>
            <h2><%= block.name %></h2>
            <ul>
      <% for (const element of block.elements) { %>
        <li>
          <button
            class="nav-item"
            data-component="<%= blockKey %>"
            data-element="<%= element.name %>"
          >
            <%= element.name %>
          </button>
        </li>
      <% } %>
    </ul>
            <% } %>
        </aside>
        <section>
            <iframe
                id="preview"
                style="width:100%; height:100%; border:0;"
            ></iframe>
            </section>
    </main>
    <footer></footer>
    <script src="./script.js" defer></script>
</body>
</html>
